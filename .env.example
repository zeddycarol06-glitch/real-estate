# Use sandbox for Daraja testing. Set production only after Safaricom activates
# your live Daraja app, shortcode and passkey.
# The STK Password is generated server-side from shortcode + passkey + the
# current Nairobi timestamp; do not add or send a Password value from the browser.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_ACCOUNT_REFERENCE=ZEDTECH
DARAJA_TRANSACTION_DESCRIPTION=Payment

# Use a publicly reachable HTTPS URL, including the exact callback path.
DARAJA_CALLBACK_URL=https://your-public-host.example/api/mpesa/callback
# Replace with a private random value of at least 32 characters.
DARAJA_CALLBACK_TOKEN=
