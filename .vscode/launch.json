{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EstatePro: run server (localhost:3000)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "skipFiles": ["<node_internals>/**"],
            "preLaunchTask": "EstatePro: ensure MongoDB",
            "serverReadyAction": {
                "pattern": "EstatePro is running at (http://localhost:[0-9]+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}
